# ==========================================
# BANCO DE DADOS
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=syra_db
DB_USER=admin
DB_PASSWORD=admin

# ==========================================
# JWT
# ==========================================
# Gere uma chave segura com: openssl rand -base64 32
JWT_SECRET=sua_chave_secreta_super_forte_com_minimo_32_caracteres_para_HS256
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ==========================================
# GOOGLE OAUTH2
# ==========================================
# Obtenha em: https://console.cloud.google.com
GOOGLE_CLIENT_ID=921270538493-jdtl9qqdn5v2d1lkhf30niokr0o6clh5.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SUA_CLIENT_SECRET_AQUI
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ==========================================
# EMAIL (SMTP)
# ==========================================
# Para desenvolvimento, use MailHog
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@syra.com.br
MAIL_ADMIN=admin@syra.com.br

# ==========================================
# SERVIDOR
# ==========================================
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_CREDENTIALS=true

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_LEVEL_COM_SYRA=DEBUG

